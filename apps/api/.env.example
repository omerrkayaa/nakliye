DATABASE_URL=postgres://nakliye:nakliye@localhost:5432/nakliye
JWT_SECRET=degistir-beni
OTP_PEPPER=degistir-beni
# dev: kodlar konsola yazılır; prod: SMS sağlayıcı adı
SMS_PROVIDER=console
PORT=3000
# SMS teyit linkinin açılacağı web adresi (link: WEB_URL/t/<token>)
WEB_URL=http://localhost:3001
# false: teyit zamanlayıcısı çalışmaz (testte turu POST /admin/jobs/confirmation-tick ile tetikle)
JOBS_ENABLED=true

# Kod isteği sınırları (NFR-04; 0 = kapalı): numara başına 24 saatte kod, IP başına saatte farklı numara.
# Uçtan uca testlerin ana sunucusu OTP_IP_HOURLY_LIMIT=0 ile çalışır (tüm takımlar tek makineden girer).
# OTP_PHONE_DAILY_LIMIT=10
# OTP_IP_HOURLY_LIMIT=20
# X-Forwarded-For'a güvenilecek vekil (Express trust proxy): loopback (varsayılan; aynı makinedeki web ve ters vekil),
# alt ağ (10.0.0.0/8), sayı (vekil sayısı) ya da false. Yayında web'in önünde gerçek adresi yazan ters vekil olmalı.
# TRUST_PROXY=loopback

# Yönetici iki adımlı doğrulamasının (TOTP) gizli anahtarlarını DB'de şifreleyen anahtar; boşsa OTP_PEPPER'dan türetilir.
# Değişirse kurulu doğrulama uygulamaları geçersizleşir (yöneticiler yeniden kurar).
# TOTP_KEY=

# Demo hesabı (yalnız SMS_PROVIDER=console iken): bu numaraya giriş kodu hep DEMO_OTP. Demo verisi: npm run db:seed-demo
DEMO_PHONE=+905550102030
DEMO_OTP=123456

# F7 karayolu mesafesi: kendi OSRM sunucumuz (kurulum infra/osrm.md). Boşsa kuş uçuşu tahminine düşülür.
OSRM_URL=http://localhost:5000

# Belge dosyaları (FR-05): yerel disk klasörü (varsayılan: çalışma klasöründe storage/; depoya girmez)
# FILE_STORAGE_DIR=storage
# İmzalı dosya bağlantısı anahtarı (5 dk); boşsa JWT_SECRET kullanılır
# FILE_URL_SECRET=
