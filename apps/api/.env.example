DATABASE_URL=postgres://nakliye:nakliye@localhost:5432/nakliye
JWT_SECRET=degistir-beni
OTP_PEPPER=degistir-beni
# dev: kodlar konsola yazılır; prod: SMS sağlayıcı adı
SMS_PROVIDER=console
PORT=3000
# SMS teyit linkinin açılacağı web adresi (link: WEB_URL/t/<token>)
WEB_URL=http://localhost:3001
# false: teyit zamanlayıcısı çalışmaz (testte turu POST /admin/jobs/confirmation-tick ile tetikle)
JOBS_ENABLED=true
